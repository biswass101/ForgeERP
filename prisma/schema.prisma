// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum user_status_enum {
  active
  inactive
  locked
}

enum style_status_enum {
  draft
  costed
  approved
  active
  discontinued
}

enum sample_type_enum {
  proto
  fit
  pp
  shipment_photo
}

enum decision_status_enum {
  pending
  approved
  rejected
  revise
}

enum order_status_enum {
  draft
  confirmed
  in_production
  partially_shipped
  shipped
  closed
  cancelled
}

enum milestone_status_enum {
  pending
  at_risk
  delayed
  completed
}

enum scan_type_enum {
  in
  out
}

enum inspection_result_enum {
  pass
  fail
}

enum severity_enum {
  critical
  major
  minor
}

enum movement_direction_enum {
  in
  out
}

enum movement_type_enum {
  receipt
  issue
  transfer
  adjustment
}

enum costing_method_enum {
  fifo
  weighted_average
}

enum po_status_enum {
  draft
  sent
  partially_received
  received
  closed
  cancelled
}

enum match_status_enum {
  pending
  matched
  discrepancy
  approved
}

enum ap_ar_status_enum {
  open
  partially_paid
  paid
  overdue
}

enum shipment_status_enum {
  booked
  loaded
  shipped
  delivered
  cancelled
}

enum payroll_status_enum {
  draft
  processing
  approved
  paid
}

enum wage_type_enum {
  monthly
  daily
  piece_rate
}

enum leave_status_enum {
  pending
  approved
  rejected
  cancelled
}

enum cap_status_enum {
  open
  in_progress
  closed
  overdue
}

enum approval_status_enum {
  pending
  approved
  rejected
}

enum material_type_enum {
  fabric
  trim
}

enum stock_item_type_enum {
  fabric
  trim
  finished_good
}

enum account_type_enum {
  asset
  liability
  equity
  income
  expense
}

enum journal_source_enum {
  sales_invoice
  supplier_invoice
  payroll
  stock_adjustment
  manual
}

enum journal_status_enum {
  draft
  posted
  reversed
}

enum attendance_status_enum {
  present
  absent
  leave
  holiday
  weekend
}

enum attendance_source_enum {
  manual
  biometric
  rfid
}

enum supplier_type_enum {
  local
  import
}

enum warehouse_type_enum {
  rm
  wip
  fg
  other
}

enum component_type_enum {
  earning
  deduction
}

enum payment_type_enum {
  payable
  receivable
}

enum party_type_enum {
  supplier
  buyer
}

enum requisition_source_enum {
  mrp
  manual
}

enum inspection_stage_enum {
  inline
  endline
  aql_final
}

enum offset_reference_enum {
  order_confirmation
  ship_date
}

enum transfer_status_enum {
  in_transit
  received
  cancelled
}

enum rework_status_enum {
  pending
  in_progress
  completed
  scrapped
}

model tenants {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  name String @db.VarChar(200)

  slug String @unique @db.VarChar(100)

  subscription_plan String @default("standard") @db.VarChar(50)

  status user_status_enum @default(active)

  default_locale String @default("en") @db.VarChar(10)

  created_at DateTime @default(now()) @db.Timestamptz(6)

  updated_at             DateTime                 @default(now()) @db.Timestamptz(6)
  companies              companies[]
  users                  users[]
  roles                  roles[]
  branches               branches[]               @relation("BranchTenant")
  factories              factories[]              @relation("FactoryTenant")
  departments            departments[]            @relation("DepartmentTenant")
  sessions               sessions[]               @relation("SessionTenant")
  audit_logs             audit_logs[]             @relation("AuditTenant")
  buyers                 buyers[]                 @relation("BuyerTenant")
  styles                 styles[]                 @relation("StyleTenant")
  sales_orders           sales_orders[]           @relation("OrderTenant")
  tna_templates          tna_templates[]          @relation("TnaTemplateTenant")
  units_of_measure       units_of_measure[]       @relation("UomTenant")
  fabrics                fabrics[]                @relation("FabricTenant")
  trims                  trims[]                  @relation("TrimTenant")
  production_lines       production_lines[]       @relation("ProductionLineTenant")
  daily_production_plans daily_production_plans[] @relation("DailyPlanTenant")
  fabric_issues          fabric_issues[]          @relation("FabricIssueTenant")
  bundle_scans           bundle_scans[]           @relation("BundleScanTenant")
  downtime_reasons       downtime_reasons[]       @relation("DowntimeReasonTenant")
  defect_codes           defect_codes[]           @relation("DefectCodeTenant")
  inline_inspections     inline_inspections[]     @relation("InlineInspectionTenant")
  endline_inspections    endline_inspections[]    @relation("EndlineInspectionTenant")
  aql_sampling_plans     aql_sampling_plans[]     @relation("AqlPlanTenant")
  aql_inspection_reports aql_inspection_reports[] @relation("AqlReportTenant")
  rework_orders          rework_orders[]          @relation("ReworkTenant")
  warehouses             warehouses[]             @relation("WarehouseTenant")
  stock_items            stock_items[]            @relation("StockItemTenant")
  stock_movements        stock_movements[]        @relation("StockMovementTenant")
  stock_transfers        stock_transfers[]        @relation("StockTransferTenant")
  stock_adjustments      stock_adjustments[]      @relation("StockAdjustmentTenant")
  suppliers              suppliers[]              @relation("SupplierTenant")
  purchase_requisitions  purchase_requisitions[]  @relation("PurchaseRequisitionTenant")
  purchase_orders        purchase_orders[]        @relation("PurchaseOrderTenant")
  goods_receipt_notes    goods_receipt_notes[]    @relation("GrnTenant")
  supplier_invoices      supplier_invoices[]      @relation("SupplierInvoiceTenant")
  shipments              shipments[]              @relation("ShipmentTenant")
  commercial_invoices    commercial_invoices[]    @relation("CommercialInvoiceTenant")
  exchange_rates         exchange_rates[]         @relation("ExchangeRateTenant")
  chart_of_accounts      chart_of_accounts[]      @relation("AccountTenant")
  journals               journals[]               @relation("JournalTenant")
  accounts_payable       accounts_payable[]       @relation("PayableTenant")
  accounts_receivable    accounts_receivable[]    @relation("ReceivableTenant")
  payments               payments[]               @relation("PaymentTenant")
  employees              employees[]              @relation("EmployeeTenant")
  attendance             attendance[]             @relation("AttendanceTenant")
  leave_types            leave_types[]            @relation("LeaveTypeTenant")
  payroll_runs           payroll_runs[]           @relation("PayrollTenant")
  compliance_schemes     compliance_schemes[]     @relation("ComplianceSchemeTenant")
  compliance_audits      compliance_audits[]      @relation("ComplianceAuditTenant")
  certificates           certificates[]           @relation("CertificateTenant")
  attachments            attachments[]            @relation("AttachmentTenant")
  notifications          notifications[]          @relation("NotificationTenant")
  rag_documents          rag_documents[]          @relation("RagTenant")
  ai_tool_call_logs      ai_tool_call_logs[]      @relation("AiLogTenant")
  cutting_orders         cutting_orders[]         @relation("CuttingOrderTenant")
  finishing_checklists   finishing_checklists[]   @relation("FinishingTenant")

  @@map("tenants")
}

model companies {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenant_id String @db.Uuid

  name String @db.VarChar(200)

  legal_name String? @db.VarChar(200)

  registration_no String? @db.VarChar(100)

  tax_id String? @db.VarChar(100)

  base_currency String @db.Char(3)

  is_active Boolean @default(true)

  tenant            tenants             @relation(fields: [tenant_id], references: [id])
  factories         factories[]
  branches          branches[]          @relation("BranchCompany")
  buyers            buyers[]            @relation("BuyerCompany")
  styles            styles[]            @relation("StyleCompany")
  fabrics           fabrics[]           @relation("FabricCompany")
  trims             trims[]             @relation("TrimCompany")
  suppliers         suppliers[]         @relation("SupplierCompany")
  chart_of_accounts chart_of_accounts[] @relation("AccountCompany")
  journals          journals[]          @relation("JournalCompany")
  employees         employees[]         @relation("EmployeeCompany")
  sales_orders      sales_orders[]      @relation("OrderCompany")

  @@unique([tenant_id, name])
  @@map("companies")
}

model factories {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenant_id String @db.Uuid

  company_id String @db.Uuid

  name String @db.VarChar(200)

  code String @db.VarChar(30)

  type String? @db.VarChar(50)

  address String? @db.VarChar(255)

  city String? @db.VarChar(100)

  country String? @db.VarChar(100)

  timezone String @default("Asia/Dhaka") @db.VarChar(50)

  is_active Boolean @default(true)

  company                companies                @relation(fields: [company_id], references: [id])
  departments            departments[]
  tenant                 tenants                  @relation("FactoryTenant", fields: [tenant_id], references: [id])
  branches               branches[]               @relation("BranchFactory")
  user_roles             user_roles[]             @relation("UserRoleFactory")
  user_factory_access    user_factory_access[]    @relation("UserFactoryAccessFactory")
  production_lines       production_lines[]       @relation("ProductionLineFactory")
  sales_orders           sales_orders[]           @relation("OrderFactory")
  daily_production_plans daily_production_plans[] @relation("DailyPlanFactory")
  fabric_issues          fabric_issues[]          @relation("FabricIssueFactory")
  cutting_orders         cutting_orders[]         @relation("CuttingOrderFactory")
  warehouses             warehouses[]             @relation("WarehouseFactory")
  purchase_requisitions  purchase_requisitions[]  @relation("PurchaseRequisitionFactory")
  shipments              shipments[]              @relation("ShipmentFactory")
  employees              employees[]              @relation("EmployeeFactory")
  payroll_runs           payroll_runs[]           @relation("PayrollFactory")
  compliance_audits      compliance_audits[]      @relation("ComplianceAuditFactory")
  certificates           certificates[]           @relation("CertificateFactory")
  order_factory_splits   order_factory_splits[]   @relation("OrderFactorySplitFactory")

  @@unique([company_id, code])
  @@map("factories")
}

model branches {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id   String     @db.Uuid
  company_id  String     @db.Uuid
  factory_id  String?    @db.Uuid
  name        String     @db.VarChar(200)
  branch_type String?    @db.VarChar(50)
  address     String?    @db.Text
  tenant      tenants    @relation("BranchTenant", fields: [tenant_id], references: [id])
  company     companies  @relation("BranchCompany", fields: [company_id], references: [id])
  factory     factories? @relation("BranchFactory", fields: [factory_id], references: [id])
}

model departments {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id            String        @db.Uuid
  factory_id           String        @db.Uuid
  name                 String        @db.VarChar(100)
  parent_department_id String?       @db.Uuid
  factory              factories     @relation(fields: [factory_id], references: [id])
  tenant               tenants       @relation("DepartmentTenant", fields: [tenant_id], references: [id])
  parent_department    departments?  @relation("DepartmentHierarchy", fields: [parent_department_id], references: [id])
  child_departments    departments[] @relation("DepartmentHierarchy")
  employees            employees[]   @relation("EmployeeDepartment")

  @@unique([factory_id, name])
}

model users {
  id                              String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id                       String                     @db.Uuid
  email                           String                     @db.VarChar(320)
  username                        String?                    @db.VarChar(100)
  password_hash                   String                     @db.VarChar(255)
  status                          user_status_enum           @default(active)
  mfa_enabled                     Boolean                    @default(false)
  password_changed_at             DateTime?                  @db.Timestamptz(6)
  last_login_at                   DateTime?                  @db.Timestamptz(6)
  failed_login_count              Int                        @default(0)
  is_deleted                      Boolean                    @default(false)
  deleted_at                      DateTime?                  @db.Timestamptz(6)
  tenant                          tenants                    @relation(fields: [tenant_id], references: [id])
  mfa_factors                     mfa_factors[]              @relation("MfaUser")
  user_roles                      user_roles[]               @relation("UserRoleUser")
  user_factory_access             user_factory_access[]      @relation("UserFactoryAccessUser")
  sessions                        sessions[]                 @relation("SessionUser")
  audit_logs                      audit_logs[]               @relation("AuditUser")
  order_amendments                order_amendments[]         @relation("OrderAmendmentUser")
  tech_packs_approved             tech_packs[]               @relation("TechPackApprovedBy")
  tna_milestones_responsible      tna_milestones[]           @relation("TnaMilestoneResponsible")
  fabric_issues_issued            fabric_issues[]            @relation("FabricIssueIssuedBy")
  markers_created                 markers[]                  @relation("MarkerCreatedBy")
  fabric_relaxation_checks        fabric_relaxation_checks[] @relation("RelaxationCheckedBy")
  finishing_checklists_checked    finishing_checklists[]     @relation("FinishingCheckedBy")
  inline_inspections_inspected    inline_inspections[]       @relation("InlineInspectedBy")
  endline_inspections_inspected   endline_inspections[]      @relation("EndlineInspectedBy")
  aql_reports_inspected           aql_inspection_reports[]   @relation("AqlInspectedBy")
  stock_adjustments_approved      stock_adjustments[]        @relation("StockAdjustmentApprovedBy")
  purchase_requisitions_requested purchase_requisitions[]    @relation("PurchaseRequisitionRequestedBy")
  purchase_requisitions_approved  purchase_requisitions[]    @relation("PurchaseRequisitionApprovedBy")
  goods_receipt_notes_received    goods_receipt_notes[]      @relation("GrnReceivedBy")
  journals_created                journals[]                 @relation("JournalCreatedBy")
  journals_approved               journals[]                 @relation("JournalApprovedBy")
  leave_applications_approved     leave_applications[]       @relation("LeaveApprovedBy")
  payroll_runs_approved           payroll_runs[]             @relation("PayrollApprovedBy")
  attachments_uploaded            attachments[]              @relation("AttachmentUploadedBy")
  notifications                   notifications[]            @relation("NotificationUser")
  ai_tool_call_logs               ai_tool_call_logs[]        @relation("AiLogUser")
  employees                       employees[]                @relation("EmployeeUser")

  @@unique([tenant_id, email])
}

model mfa_factors {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String  @db.Uuid
  factor_type      String  @db.VarChar(30)
  secret_encrypted String? @db.Text
  is_verified      Boolean @default(false)
  user             users   @relation("MfaUser", fields: [user_id], references: [id])
}

model roles {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id        String?            @db.Uuid
  name             String             @db.VarChar(100)
  is_system_role   Boolean            @default(false)
  tenant           tenants?           @relation(fields: [tenant_id], references: [id])
  role_permissions role_permissions[] @relation("RolePermissionRole")
  user_roles       user_roles[]       @relation("UserRoleRole")

  @@unique([tenant_id, name])
}

model permissions {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String             @unique @db.VarChar(100)
  module           String             @db.VarChar(50)
  action           String             @db.VarChar(50)
  description      String?            @db.Text
  role_permissions role_permissions[] @relation("RolePermissionPermission")
}

model role_permissions {
  role_id       String      @db.Uuid
  permission_id String      @db.Uuid
  role          roles       @relation("RolePermissionRole", fields: [role_id], references: [id], onDelete: Cascade)
  permission    permissions @relation("RolePermissionPermission", fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
}

model user_roles {
  user_id    String    @db.Uuid
  role_id    String    @db.Uuid
  factory_id String    @db.Uuid
  user       users     @relation("UserRoleUser", fields: [user_id], references: [id], onDelete: Cascade)
  role       roles     @relation("UserRoleRole", fields: [role_id], references: [id], onDelete: Cascade)
  factory    factories @relation("UserRoleFactory", fields: [factory_id], references: [id])

  @@id([user_id, role_id, factory_id])
}

model user_factory_access {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  factory_id String    @db.Uuid
  is_primary Boolean   @default(false)
  user       users     @relation("UserFactoryAccessUser", fields: [user_id], references: [id])
  factory    factories @relation("UserFactoryAccessFactory", fields: [factory_id], references: [id])

  @@unique([user_id, factory_id])
}

model sessions {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id      String               @db.Uuid
  user_id        String               @db.Uuid
  ip_address     Unsupported("inet")?
  user_agent     String?              @db.Text
  created_at     DateTime             @default(now()) @db.Timestamptz(6)
  expires_at     DateTime             @db.Timestamptz(6)
  revoked_at     DateTime?            @db.Timestamptz(6)
  tenant         tenants              @relation("SessionTenant", fields: [tenant_id], references: [id])
  user           users                @relation("SessionUser", fields: [user_id], references: [id])
  refresh_tokens refresh_tokens[]     @relation("RefreshTokenSession")
}

model refresh_tokens {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id           String           @db.Uuid
  token_hash           String           @unique @db.VarChar(255)
  issued_at            DateTime         @default(now()) @db.Timestamptz(6)
  expires_at           DateTime         @db.Timestamptz(6)
  revoked_at           DateTime?        @db.Timestamptz(6)
  replaced_by_token_id String?          @db.Uuid
  session              sessions         @relation("RefreshTokenSession", fields: [session_id], references: [id], onDelete: Cascade)
  replaced_by_token    refresh_tokens?  @relation("RefreshTokenRotation", fields: [replaced_by_token_id], references: [id])
  replacing_tokens     refresh_tokens[] @relation("RefreshTokenRotation")
}

model audit_logs {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id   String               @db.Uuid
  user_id     String?              @db.Uuid
  action      String               @db.VarChar(100)
  entity_type String?              @db.VarChar(100)
  entity_id   String?              @db.Uuid
  before_data Json?
  after_data  Json?
  ip_address  Unsupported("inet")?
  user_agent  String?              @db.Text
  occurred_at DateTime             @default(now()) @db.Timestamptz(6)
  tenant      tenants              @relation("AuditTenant", fields: [tenant_id], references: [id])
  user        users?               @relation("AuditUser", fields: [user_id], references: [id])
}

model buyers {
  id                           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id                    String                @db.Uuid
  company_id                   String                @db.Uuid
  name                         String                @db.VarChar(200)
  code                         String                @db.VarChar(50)
  payment_terms                String?               @db.VarChar(200)
  shipping_preferences         Json?
  compliance_requirements      Json?
  default_aql_sampling_plan_id String?               @db.Uuid
  is_active                    Boolean               @default(true)
  tenant                       tenants               @relation("BuyerTenant", fields: [tenant_id], references: [id])
  company                      companies             @relation("BuyerCompany", fields: [company_id], references: [id])
  default_aql_sampling_plan    aql_sampling_plans?   @relation("BuyerDefaultAql", fields: [default_aql_sampling_plan_id], references: [id])
  contacts                     buyer_contacts[]      @relation("BuyerContacts")
  styles                       styles[]              @relation("StyleBuyer")
  sales_orders                 sales_orders[]        @relation("OrderBuyer")
  commercial_invoices          commercial_invoices[] @relation("CommercialInvoiceBuyer")
  accounts_receivable          accounts_receivable[] @relation("ReceivableBuyer")

  @@unique([tenant_id, code])
}

model buyer_contacts {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  buyer_id    String  @db.Uuid
  name        String  @db.VarChar(150)
  designation String? @db.VarChar(100)
  email       String? @db.VarChar(320)
  phone       String? @db.VarChar(30)
  buyer       buyers  @relation("BuyerContacts", fields: [buyer_id], references: [id], onDelete: Cascade)
}

model styles {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id           String                @db.Uuid
  company_id          String                @db.Uuid
  buyer_id            String                @db.Uuid
  style_code          String                @db.VarChar(100)
  name                String?               @db.VarChar(200)
  description         String?               @db.Text
  category            String?               @db.VarChar(100)
  season              String?               @db.VarChar(50)
  size_range          String?               @db.VarChar(50)
  status              style_status_enum     @default(draft)
  tenant              tenants               @relation("StyleTenant", fields: [tenant_id], references: [id])
  company             companies             @relation("StyleCompany", fields: [company_id], references: [id])
  buyer               buyers                @relation("StyleBuyer", fields: [buyer_id], references: [id])
  sizes               style_sizes[]         @relation("StyleSizes")
  colors              style_colors[]        @relation("StyleColors")
  tech_packs          tech_packs[]          @relation("TechPackStyle")
  boms                boms[]                @relation("BomStyle")
  costing_sheets      costing_sheets[]      @relation("CostingStyle")
  samples             samples[]             @relation("SampleStyle")
  sales_orders        sales_orders[]        @relation("OrderStyle")
  markers             markers[]             @relation("MarkerStyle")
  operation_bulletins operation_bulletins[] @relation("BulletinStyle")
  wash_recipes        wash_recipes[]        @relation("WashRecipeStyle")
  stock_items         stock_items[]         @relation("StockItemStyle")

  @@unique([tenant_id, buyer_id, style_code])
}

model style_sizes {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  style_id     String         @db.Uuid
  size_name    String         @db.VarChar(20)
  sort_order   Int            @db.SmallInt
  style        styles         @relation("StyleSizes", fields: [style_id], references: [id], onDelete: Cascade)
  bom_items    bom_items[]    @relation("BomItemSize")
  order_lines  order_lines[]  @relation("OrderLineSize")
  cut_bundles  cut_bundles[]  @relation("CutBundleSize")
  carton_items carton_items[] @relation("CartonItemSize")
  stock_items  stock_items[]  @relation("StockItemSize")

  @@unique([style_id, size_name])
}

model style_colors {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  style_id     String         @db.Uuid
  color_name   String         @db.VarChar(50)
  color_code   String?        @db.VarChar(20)
  style        styles         @relation("StyleColors", fields: [style_id], references: [id], onDelete: Cascade)
  order_lines  order_lines[]  @relation("OrderLineColor")
  cut_bundles  cut_bundles[]  @relation("CutBundleColor")
  carton_items carton_items[] @relation("CartonItemColor")
  stock_items  stock_items[]  @relation("StockItemColor")

  @@unique([style_id, color_name])
}

model tech_packs {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  style_id             String       @db.Uuid
  version              Int          @default(1)
  attachment_id        String?      @db.Uuid
  construction_details Json?
  approved_by          String?      @db.Uuid
  approved_at          DateTime?    @db.Timestamptz(6)
  style                styles       @relation("TechPackStyle", fields: [style_id], references: [id], onDelete: Cascade)
  attachment           attachments? @relation("TechPackAttachment", fields: [attachment_id], references: [id])
  approved_by_user     users?       @relation("TechPackApprovedBy", fields: [approved_by], references: [id])

  @@unique([style_id, version])
}

model boms {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  style_id       String               @db.Uuid
  version        Int                  @default(1)
  status         approval_status_enum @default(pending)
