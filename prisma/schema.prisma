  balances          leave_balances[]     @relation("LeaveTypeBalance")

  @@unique([tenant_id, name])
}

model leave_applications {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id      String            @db.Uuid
  leave_type_id    String            @db.Uuid
  start_date       DateTime          @db.Date
  end_date         DateTime          @db.Date
  days_count       Decimal           @db.Decimal(5, 1)
  reason           String?           @db.Text
  status           leave_status_enum @default(pending)
  approved_by      String?           @db.Uuid
  employee         employees         @relation("LeaveApplicationEmployee", fields: [employee_id], references: [id])
  leave_type       leave_types       @relation("LeaveTypeApplication", fields: [leave_type_id], references: [id])
  approved_by_user users?            @relation("LeaveApprovedBy", fields: [approved_by], references: [id])
}

model leave_balances {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id   String      @db.Uuid
  leave_type_id String      @db.Uuid
  year          Int         @db.SmallInt
  entitled_days Decimal     @db.Decimal(5, 1)
  used_days     Decimal     @default(0) @db.Decimal(5, 1)
  balance_days  Decimal     @db.Decimal(5, 1)
  employee      employees   @relation("LeaveBalanceEmployee", fields: [employee_id], references: [id])
  leave_type    leave_types @relation("LeaveTypeBalance", fields: [leave_type_id], references: [id])

  @@unique([employee_id, leave_type_id, year])
}

model salary_structures {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id    String         @db.Uuid
  effective_date DateTime       @db.Date
  basic_salary   Decimal        @default(0) @db.Decimal(14, 2)
  allowances     Json?
  wage_type      wage_type_enum
  employee       employees      @relation("SalaryStructureEmployee", fields: [employee_id], references: [id])

  @@unique([employee_id, effective_date])
}

model payroll_runs {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id        String              @db.Uuid
  factory_id       String              @db.Uuid
  pay_period_start DateTime            @db.Date
  pay_period_end   DateTime            @db.Date
  status           payroll_status_enum @default(draft)
  run_date         DateTime            @db.Date
  approved_by      String?             @db.Uuid
  tenant           tenants             @relation("PayrollTenant", fields: [tenant_id], references: [id])
  factory          factories           @relation("PayrollFactory", fields: [factory_id], references: [id])
  approved_by_user users?              @relation("PayrollApprovedBy", fields: [approved_by], references: [id])

  @@unique([factory_id, pay_period_start, pay_period_end])
}

model payslips {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payroll_run_id    String   @db.Uuid
  employee_id       String   @db.Uuid
  base_wage         Decimal  @default(0) @db.Decimal(14, 2)
  overtime_amount   Decimal  @default(0) @db.Decimal(14, 2)
  incentive_amount  Decimal  @default(0) @db.Decimal(14, 2)
  gross_pay         Decimal  @db.Decimal(14, 2)
  deductions_amount Decimal  @default(0) @db.Decimal(14, 2)
  net_pay           Decimal  @db.Decimal(14, 2)
  generated_at      DateTime @default(now()) @db.Timestamptz(6)

  @@unique([payroll_run_id, employee_id])
}

model payslip_lines {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payslip_id     String              @db.Uuid
  component_type component_type_enum
  component_name String              @db.VarChar(100)
  amount         Decimal             @db.Decimal(14, 2)
}

model compliance_schemes {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id String  @db.Uuid
  name      String  @db.VarChar(100)
  tenant    tenants @relation("ComplianceSchemeTenant", fields: [tenant_id], references: [id])

  @@unique([tenant_id, name])
}

model compliance_audits {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id            String    @db.Uuid
  factory_id           String    @db.Uuid
  compliance_scheme_id String    @db.Uuid
  auditor_name         String?   @db.VarChar(150)
  audit_date           DateTime  @db.Date
  score                Decimal?  @db.Decimal(6, 2)
  grade                String?   @db.VarChar(20)
  findings_summary     String?   @db.Text
  status               String    @default("completed") @db.VarChar(20)
  tenant               tenants   @relation("ComplianceAuditTenant", fields: [tenant_id], references: [id])
  factory              factories @relation("ComplianceAuditFactory", fields: [factory_id], references: [id])
}

model corrective_action_plans {
  id                             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  compliance_audit_id            String          @db.Uuid
  finding_description            String          @db.Text
  owner_employee_id              String          @db.Uuid
  due_date                       DateTime        @db.Date
  status                         cap_status_enum @default(open)
  closure_evidence_attachment_id String?         @db.Uuid
}

model certificates {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id        String    @db.Uuid
  factory_id       String    @db.Uuid
  certificate_type String    @db.VarChar(50)
  issuing_body     String?   @db.VarChar(150)
  scope            String?   @db.Text
  valid_from       DateTime  @db.Date
  valid_to         DateTime  @db.Date
  attachment_id    String?   @db.Uuid
  tenant           tenants   @relation("CertificateTenant", fields: [tenant_id], references: [id])
  factory          factories @relation("CertificateFactory", fields: [factory_id], references: [id])
}

model compliance_documents {
  id                  String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  related_entity_type String @db.VarChar(30)
  related_entity_id   String @db.Uuid
  attachment_id       String @db.Uuid
}

model attachments {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id         String                   @db.Uuid
  entity_type       String                   @db.VarChar(50)
  entity_id         String                   @db.Uuid
  file_name         String                   @db.VarChar(255)
  storage_key       String                   @db.Text
  mime_type         String                   @db.VarChar(100)
  size_bytes        BigInt
  uploaded_by       String                   @db.Uuid
  uploaded_at       DateTime                 @default(now()) @db.Timestamptz(6)
  virus_scan_status String                   @default("pending") @db.VarChar(20)
  tenant            tenants                  @relation("AttachmentTenant", fields: [tenant_id], references: [id])
  uploaded_by_user  users                    @relation("AttachmentUploadedBy", fields: [uploaded_by], references: [id])
  tech_packs        tech_packs[]             @relation("TechPackAttachment")
  aql_reports       aql_inspection_reports[] @relation("AqlReportAttachment")

  @@index([entity_type, entity_id])
}

model notifications {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id           String   @db.Uuid
  user_id             String   @db.Uuid
  notification_type   String   @db.VarChar(50)
  title               String   @db.VarChar(200)
  body                String?  @db.Text
  related_entity_type String?  @db.VarChar(50)
  related_entity_id   String?  @db.Uuid
  is_read             Boolean  @default(false)
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  tenant              tenants  @relation("NotificationTenant", fields: [tenant_id], references: [id])
  user                users    @relation("NotificationUser", fields: [user_id], references: [id])
}

model rag_documents {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id            String                @db.Uuid
  source_type          String                @db.VarChar(50)
  source_attachment_id String?               @db.Uuid
  content_chunk        String                @db.Text
  embedding            Unsupported("vector")
  created_at           DateTime              @default(now()) @db.Timestamptz(6)
  tenant               tenants               @relation("RagTenant", fields: [tenant_id], references: [id])
}

model ai_tool_call_logs {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id      String   @db.Uuid
  user_id        String   @db.Uuid
  tool_name      String   @db.VarChar(100)
  arguments      Json
  result_summary Json?
  called_at      DateTime @default(now()) @db.Timestamptz(6)
  tenant         tenants  @relation("AiLogTenant", fields: [tenant_id], references: [id])
  user           users    @relation("AiLogUser", fields: [user_id], references: [id])
}
